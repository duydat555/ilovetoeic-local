# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=toeic_app
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=toeic_db

# Application authentication
APP_SECRET=replace-with-at-least-32-random-characters
PUBLIC_API_URL=http://127.0.0.1:8000
CLIENT_URL=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Translation providers (multi-provider routing is off by default)
TRANSLATION_MULTI_PROVIDER_ENABLED=false
DEEPL_API_KEY=
DEEPL_API_BASE_URL=https://api-free.deepl.com
DEEPL_MONTHLY_CHAR_BUDGET=450000
DEEPL_WEIGHT=70
MAX_DEEPL_CONCURRENCY=5
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_MONTHLY_CHAR_BUDGET=450000
GOOGLE_TRANSLATE_WEIGHT=30
MAX_GOOGLE_TRANSLATE_CONCURRENCY=5
GEMINI_TRANSLATION_MAX_CONCURRENCY=2
GEMINI_TRANSLATION_MONTHLY_CHAR_BUDGET=50000
TRANSLATION_PROVIDER_TIMEOUT_MS=2500
TRANSLATION_MAX_PROVIDER_ATTEMPTS=2
TRANSLATION_MACHINE_CACHE_TTL_SECONDS=2592000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudflare R2 media (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

HOST=0.0.0.0
PORT=8000

# Enable only after applying the additive exam-notes migration.
EXAM_NOTES_ENABLED=false
